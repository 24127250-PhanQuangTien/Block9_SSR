<%- include('../partials/header', { title }) %>
<%- include('../partials/navbar', { solidNavbar: true }) %>
<section class="section" style="padding-top: 120px;"><div class="container"><div class="form-card">
  <div class="form-header"><h1 class="form-title">Thiết Lập MFA</h1><p class="form-subtitle">Quét QR bằng ứng dụng xác thực hoặc nhập secret thủ công.</p></div>
  <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
  <% if (qr) { %><div aria-label="Mã QR MFA"><%- qr %></div><p><strong>Secret:</strong> <code><%= secret %></code></p><% } %>
  <form action="/account/security/setup/confirm" method="POST" class="standard-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group"><label for="code" class="form-label required">Mã 6 số</label><input id="code" name="code" class="form-control" inputmode="numeric" autocomplete="one-time-code" required></div>
    <button class="btn btn--primary">Bật MFA</button>
  </form>
</div></div></section>
<%- include('../partials/footer') %>
