<%- include('start') %>
<form action="/activate" method="POST" class="auth-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="email">Email</label><input id="email" name="email" type="email" value="<%= email %>" autocomplete="email" maxlength="254" required>
  <label for="otp">Mã kích hoạt 6 chữ số</label><input id="otp" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required>
  <button type="submit" class="btn btn--primary">Kích Hoạt</button>
</form>
<form action="/activate/resend" method="POST" class="auth-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="resend-email">Email cần gửi lại mã</label><input id="resend-email" name="email" type="email" value="<%= email %>" autocomplete="email" maxlength="254" required>
  <button type="submit" class="btn">Gửi Lại Mã</button>
</form>
<%- include('end') %>
