<%- include('../partials/header', { title: 'Thực Đơn - RESTORAN' }) %>
<%- include('../partials/navbar') %>

<section class="page-hero menu-hero" aria-labelledby="menu-hero-title">
  <picture class="page-hero__bg" aria-hidden="true"><source media="(max-width: 600px)" srcset="/assets/img/menu-hero-800.webp"><img src="/assets/img/menu-hero-1600.webp" width="1600" height="666" alt="" fetchpriority="high" decoding="async"></picture>
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__content">
    <div class="hero-pill-badge"><span class="hero-pill-badge__dot"></span><span>TINH HOA ẨM THỰC BISTRO VIỆT NAM</span></div>
    <h1 id="menu-hero-title" class="page-hero__title">Hương Vị Việt Trọn Vẹn Từng Món Ăn</h1>
    <p class="page-hero__description">Thưởng thức tinh hoa ẩm thực truyền thống Việt Nam trong không gian Bistro đương đại, phục vụ tận tâm từ nguồn nguyên liệu tươi sạch mỗi ngày.</p>
    <div class="hero-actions"><a href="#thuc-don" class="hero-btn-main">Khám Phá Thực Đơn <%- include('../partials/icon', { name: 'down' }) %></a></div>
    <div class="hero-stats">
      <% [['star','4.9/5','Đánh giá hài lòng'],['leaf','100%','Nguyên liệu tươi sạch'],['chef','10+','Bếp trưởng đạt chuẩn']].forEach(([icon,number,label], i) => { %>
        <% if(i) { %><div class="hero-stat-divider" aria-hidden="true"></div><% } %>
        <div class="hero-stat-item"><span class="hero-stat-number"><%- include('../partials/icon', { name: icon }) %> <%= number %></span><span class="hero-stat-label"><%= label %></span></div>
      <% }); %>
    </div>
  </div>
</section>
<section class="section menu-section" id="thuc-don">
  <div class="container">
    <div class="section-header cuisine-heading"><span class="section-header__label">RESTORAN CUISINE</span><h2>Thực Đơn Món Ăn</h2><div class="section-header__divider"></div><p>Khám phá tinh hoa ẩm thực truyền thống và đương đại, phục vụ tận tâm mỗi ngày.</p></div>
    <!-- Thanh Tìm Kiếm (Form GET chuẩn, không fetch/AJAX) -->
    <div class="dish-search-panel">
      <div class="dish-results-toolbar"><span class="dish-results-count"><%= pagination.total.toLocaleString('vi-VN') %> món phù hợp</span></div>
      <form action="/dishes" method="GET" autocomplete="off" class="dish-search-form">
        <input type="hidden" name="page" value="1">
        <div class="dish-search-primary-fields ssr-public-search">
        <div class="dish-form-field">
          <label for="dish-query">Từ khóa</label>
          <input 
            id="dish-query"
            type="text" 
            name="q" 
            aria-label="Tìm món ăn theo tên"
            value="<%= typeof q !== 'undefined' ? q : '' %>" 
            placeholder="Tìm món ăn theo tên (Ví dụ: Phở, Bún chả...)" 
            class="search-input"
          >
        </div>
        <div class="dish-form-field"><%- include('../partials/pageSize') %></div>
        </div>
        <div class="dish-search-footer"><div class="dish-search-actions">
          <button type="submit" class="btn btn--primary"><%- include('../partials/icon', { name: 'search' }) %> Tìm Kiếm</button>
          <a href="/dishes" class="btn btn--outline">Xóa điều kiện</a>
        </div></div>
      </form>
      <% if (q) { %>
        <div class="search-status">
          Kết quả tìm kiếm cho từ khóa: <strong>"<%= q %>"</strong> (tìm thấy <%= pagination.total %> món)
        </div>
      <% } %>
    </div>

    <%- include('../partials/resultSummary') %>

    <!-- Danh Sách Món Ăn Phong Cách Bistro -->
    <% if (dishes.length === 0) { %>
      <div class="empty-state" style="text-align: center; padding: 60px 0;">
        <h3 style="font-size: 1.8rem; margin-bottom: 12px;">Không tìm thấy món ăn nào</h3>
        <p style="color: var(--text-muted); margin-bottom: 24px;">Vui lòng thử tìm kiếm với từ khóa khác hoặc quay lại xem toàn bộ thực đơn.</p>
        <a href="/dishes" class="btn btn--primary">Xem Tất Cả Món Ăn</a>
      </div>
    <% } else { %>
      <div class="menu-grid">
        <% dishes.forEach(function(dish) { 
             const imgIndex = ((dish.id - 1) % 6) + 1;
             const fallbackImg = '/assets/img/food-' + imgIndex + '.svg';
             const displayImg = dish.imageUrl || fallbackImg;
        %>
          <div class="menu-item">
            <div class="menu-item__image">
              <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= dish.name %>" onerror="this.onerror=null; this.src='<%= fallbackImg %>';">
            </div>
            <div class="menu-item__info">
              <div class="menu-item__header">
                <a href="/dishes/<%= dish.id %>" class="menu-item__name"><%= dish.name %></a>
                <span class="menu-item__dots"></span>
                <span class="menu-item__price"><%= dish.price.toLocaleString('vi-VN') %> đ</span>
              </div>
              <div class="dish-card-meta">
                <span class="dish-card-meta__line">Bếp: <%= dish.chef ? dish.chef.name : 'Đang cập nhật' %></span>
                <span class="dish-card-meta__line">Nguyên liệu: <%= dish.ingredients && dish.ingredients.length ? dish.ingredients.map(i => i.name).join(', ') : 'Đang cập nhật' %></span>
              </div>
              <div class="menu-item__tags">
                <% if (dish.category) { %>
                  <span class="menu-item__tag menu-item__tag--cat"><%= dish.category %></span>
                <% } %>
                <span class="menu-item__tag <%= dish.available ? 'menu-item__tag--available' : 'menu-item__tag--unavailable' %>">
                  <%= dish.available ? 'Đang phục vụ' : 'Tạm hết' %>
                </span>
                <a href="/dishes/<%= dish.id %>" class="menu-item__tag menu-item__tag--unit">Xem Chi Tiết →</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
    <%- include('../partials/pagination') %>
  </div>
</section>

<%- include('../partials/footer') %>
