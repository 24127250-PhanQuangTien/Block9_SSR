PORT=3000
NODE_ENV=development

# Supabase PostgreSQL Session Pooler connection string (Port 5432)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Generate independent random values >=32 chars (npm run auth:configure can append
# missing LOCAL values without printing secrets). Never reuse examples in production.
SESSION_SECRET=""
OTP_PEPPER=""
MFA_ENCRYPTION_KEY=""

# Must match the origin opened by the browser. Production must use HTTPS.
APP_BASE_URL="http://localhost:3000"
APP_ORIGIN="http://localhost:3000"
# false for direct localhost. Set the exact proxy hop/IP configuration only behind
# a trusted reverse proxy; it controls req.ip and Secure cookies.
TRUST_PROXY=false

# Obtain SMTP credentials from the mail provider; keep values only in .env.
# No SMTP_HOST => Nodemailer Ethereal; application logs ONLY a private preview URL.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Restaurant <no-reply@example.test>"

# seed:auth creates/updates the four active RBAC fixtures and never prints credentials.
# auth:configure generates LOCAL missing credentials privately; it does not seed.
SEED_VIEWER_EMAIL=""
SEED_VIEWER_PASSWORD=""
SEED_EDITOR_A_EMAIL=""
SEED_EDITOR_A_PASSWORD=""
SEED_EDITOR_B_EMAIL=""
SEED_EDITOR_B_PASSWORD=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
