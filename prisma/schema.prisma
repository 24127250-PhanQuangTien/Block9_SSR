generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dish {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  price       Int
  category    String?
  available   Boolean      @default(true)
  imageUrl    String?
  chefId      Int?
  chef        Chef?        @relation(fields: [chefId], references: [id], onDelete: SetNull)
  ingredients Ingredient[]
  createdAt   DateTime     @default(now())

  @@map("dishes")
}

model Chef {
  id        Int      @id @default(autoincrement())
  name      String
  specialty String
  dishes    Dish[]
  createdAt DateTime @default(now())

  @@map("chefs")
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Int      @default(0)
  unit      String
  dishes    Dish[]
  createdAt DateTime @default(now())

  @@map("ingredients")
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  emailRaw            String
  email               String                @unique
  passwordHash        String
  role                String                @default("viewer")
  status              String                @default("pending")
  emailVerifiedAt     DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  activationChallenge ActivationChallenge?
  passwordResets      PasswordReset[]
  sessions            Session[]
}

model ActivationChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose         String    @default("activation")
  otpHash         String
  expiresAt       DateTime
  attempts        Int       @default(0)
  lockedUntil     DateTime?
  lastSentAt      DateTime
  sendCount       Int       @default(1)
  sendWindowStart DateTime
  usedAt          DateTime?

  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CaptchaChallenge {
  id        String    @id @db.Uuid
  anonId    String
  purpose   String
  answer    String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([expiresAt])
  @@index([anonId, purpose])
}

model RateLimit {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?

  @@index([windowStart])
  @@index([lockedUntil])
}

model Session {
  sid       String   @id
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}
