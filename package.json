{
  "name": "restaurant-ssr-app",
  "version": "1.0.0",
  "description": "Restaurant SSR Web Application with Express, EJS, Prisma ORM and Supabase PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/validation.test.js tests/http.test.js tests/pagination.test.js tests/auth.security.test.js",
    "test:db": "node --test tests/database.test.js",
    "seed": "node prisma/seed.js",
    "crawl": "node scripts/crawl-dishes.js",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "auth:configure": "node scripts/configure-auth.js",
    "mail:configure": "node scripts/configure-mail.js",
    "mail:check": "node tests/mail-smoke.js",
    "db:auth:generate": "node scripts/auth-db.js generate",
    "db:auth": "node scripts/auth-db.js deploy",
    "seed:auth": "node prisma/seed-auth.js",
    "test:auth": "node tests/auth.integration.js",
    "test:browser": "node tests/pagination.browser.js",
    "test:pagination:real": "node tests/verify-pagination-readonly.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "argon2": "^0.45.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.19.0",
    "method-override": "^3.0.0",
    "nodemailer": "^10.3.1",
    "svg-captcha": "^1.4.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "prisma": "^5.21.1"
  }
}
